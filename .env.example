# Copy to .env and fill in your own values, then restart the dev server.
# Google sign-in (Google Cloud Console → APIs & Services → Credentials → Create
# Credentials → OAuth client ID → Web application):
# - Authorized JavaScript origins: http://localhost:3000 (plus your production domain)
# - No client secret needed for the Sign In with Google button.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Backend cutover (see BACKEND_READINESS.md). Leave as-is for the localStorage prototype.
# VITE_DATA_SOURCE=local
# VITE_API_URL=https://your-api.example.com
